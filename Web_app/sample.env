# ── Auth0 ────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/
AUTH0_SECRET=a-long-random-secret-used-to-sign-session-cookies
AUTH0_CONNECTION_NAME=google-oauth2   # Auth0 connection name for Google account linking

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://127.0.0.1:5000    # Change to your public URL in production
APP_SECRET_KEY=a-long-random-secret-for-starlette-sessions

# ── Connected account scopes (Google) ────────────────────────────────────────
CONNECTED_ACCOUNT_SCOPE=openid profile email https://www.googleapis.com/auth/cloud-platform

# ── Auth0 FGA ────────────────────────────────────────────────────────────────
FGA_API_HOST=api.us1.fga.dev
FGA_STORE_ID=your-fga-store-id
FGA_CLIENT_ID=your-fga-client-id
FGA_CLIENT_SECRET=your-fga-client-secret
FGA_API_TOKEN_ISSUER=auth.fga.us
FGA_API_AUDIENCE=https://api.us1.fga.dev/
FGA_AUTHORIZATION_MODEL_ID=your-fga-authorization-model-id

# ── Google Cloud / Vertex AI ─────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_AGENT_ORCHESTRATOR=projects/your-project/locations/us-central1/reasoningEngines/your-orchestrator-id
